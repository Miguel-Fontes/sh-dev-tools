keybind=clear
# Re-registra copy/paste: o acelerador do menu dispara ANTES do key-remap,
# então Cmd+C / Cmd+V voltam a funcionar mesmo com left_super=alt
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard

# Command esquerdo passa a agir como Alt (pros binds Alt+... do zellij)
key-remap = left_super=alt
# Option volta a ser Option (caracteres especiais), já que agora o Alt vem do Command-esq
macos-option-as-alt = left

# theme = matrix
# theme = breeze
# theme = carbonfox
# theme = dark modern
# theme = dark+
theme = darkside
# theme = doomone